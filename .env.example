# =============================================================================
# PRABHUPOOJA BACKEND CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. Copy this file to `.env` for local development or `.env.production` for production.
# 2. Update the values corresponding to your environment.
# 3. NEVER commit your actual `.env` file to git.
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Base URLs
BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://www.prabhupooja.com,https://admin.prabhupooja.com

# -----------------------------------------------------------------------------
# Database Configuration (MySQL)
# -----------------------------------------------------------------------------
# For Local Development (Default XAMPP / Local MySQL):
DbHost=localhost
DbUser=root
DbPassword=
DbName=prabhupooja
DbPort=3306

# For Production (AWS RDS MySQL / Live):
# DbHost=prabhupooja.ct4y6cuii4z8.ap-south-1.rds.amazonaws.com
# DbUser=admin
# DbPassword=YOUR_RDS_PASSWORD
# DbName=prabhupooja
# DbPort=3306

# -----------------------------------------------------------------------------
# AWS S3 Storage Configuration
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=prabhupooja1

# -----------------------------------------------------------------------------
# Authentication & Security Keys
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=PrabhuPooja@123
SESSION_SECRET=YOUR_SESSION_SECRET_KEY

# Google OAuth Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
