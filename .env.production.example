# =============================================================================
# PRABHUPOOJA BACKEND PRODUCTION CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. On your production server / VPS, copy this file as `.env`:
#    cp .env.production.example .env
# 2. Fill in the live credentials and domain names.
# 3. NEVER commit your actual `.env` file to git.
# =============================================================================

NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# Base URLs
BACKEND_URL=https://api.prabhupooja.com
FRONTEND_URL=https://www.prabhupooja.com
ALLOWED_ORIGINS=https://www.prabhupooja.com,https://admin.prabhupooja.com,https://pandit.prabhupooja.com

# Database (AWS RDS / Production MySQL)
DbHost=prabhupooja.ct4y6cuii4z8.ap-south-1.rds.amazonaws.com
DbUser=admin
DbPassword=YOUR_RDS_PRODUCTION_PASSWORD
DbName=prabhupooja
DbPort=3306

# AWS S3 Storage
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=prabhupooja1

# Authentication & Security Keys
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
SESSION_SECRET=YOUR_SESSION_SECRET_KEY

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://api.prabhupooja.com/auth/google/callback
GOOGLE_MOBILE_CLIENT_ID=YOUR_GOOGLE_MOBILE_CLIENT_ID.apps.googleusercontent.com

# Razorpay (Live Keys)
RazorPay_Key_Id=YOUR_RAZORPAY_LIVE_KEY_ID
RazorPay_Key_Secret=YOUR_RAZORPAY_LIVE_SECRET

# Twilio
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_API_KEY=YOUR_TWILIO_API_KEY
TWILIO_API_SECRET=YOUR_TWILIO_API_SECRET

# SMS & MSG91
SMS_api_key=YOUR_SMS_API_KEY
SMS_api_secret=YOUR_SMS_API_SECRET
MSG91_API_KEY=YOUR_MSG91_API_KEY
SENDER_ID=Prabhupooja

# Email
email=prabhupooja2024@gmail.com
pass=YOUR_GMAIL_APP_PASSWORD
ZOHO_EMAIL=welcome@prabhupooja.com
ZOHO_PASS=YOUR_ZOHO_APP_PASSWORD

# Redis (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
